<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Herramienta de Seguimiento PIIP · ESAP Nacional</title>
<style>
  :root{
    --navy-dark:#0A2240; --navy:#123A63; --navy-2:#1B4A7C;
    --gold:#E8B93A; --gold-soft:#FBF1D9;
    --green:#1FB37A; --green-soft:#E4F6EE;
    --blue:#2E86D6; --blue-soft:#E5F1FC;
    --orange:#E8590C; --orange-soft:#FDEBE0;
    --grey:#C9D0D9; --track:#EEF1F5;
    --bg:#0A2240; --card:#FFFFFF; --border:#E4E8EE;
    --text:#1B2635; --text-dim:#5B6472; --text-faint:#8A94A3;
  }
  *{ box-sizing:border-box; margin:0; padding:0; }
  body{
    background: var(--bg);
    color: var(--text);
    font-family: 'Segoe UI', 'Inter', -apple-system, sans-serif;
    padding: 0 0 50px;
    line-height:1.45;
  }
  svg{ display:block; }

  .head{
    background: linear-gradient(135deg, var(--navy-dark), var(--navy-2));
    color:#fff;
    padding: 26px 40px 30px;
    display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:16px;
  }
  .head h1{ font-size:23px; font-weight:700; }
  .head .sub{ font-size:13px; color:#BFD2E8; margin-top:6px; }
  .head-right{ display:flex; align-items:center; gap:16px; }
  .head-amt{ text-align:right; }
  .head-amt .lab{ font-size:11.5px; color:#9FB6D2; }
  .head-amt b{ color:var(--gold); font-size:24px; display:block; font-weight:800; }
  .sync-note{ font-size:11.5px; color:#7FD9AE; font-weight:700; margin-top:4px; }
  .btn{ border:none; cursor:pointer; font-family:inherit; font-size:13px; font-weight:700; padding:10px 18px; border-radius:7px; }
  .btn-ghost{ background:rgba(255,255,255,.12); color:#fff; border:1.5px solid rgba(255,255,255,.4); }
  .btn-ghost:hover{ background:rgba(255,255,255,.2); }
  .btn-primary{ background:var(--gold); color:var(--navy-dark); }
  .btn-link{ background:none; color:#9FB6D2; text-decoration:underline; font-size:11.5px; padding:0; }

  .wrap{ max-width:1360px; margin:0 auto; padding: 26px 40px 0; }

  .card{ background:var(--card); border-radius:14px; padding:26px 30px; box-shadow:0 8px 28px rgba(0,0,0,.18); }
  .sect{ margin-bottom:22px; }
  .section-title{ font-size:19px; font-weight:800; color:#fff; margin-bottom:4px; }
  .section-title.dark{ color:var(--navy-dark); }
  .section-sub{ font-size:13.5px; color:var(--text-dim); margin-bottom:20px; }
  .section-sub.light{ color:#BFD2E8; margin-bottom:18px; }

  #editPanel{ display:none; margin-bottom:22px; border-top:5px solid var(--gold); }
  #editPanel.open{ display:block; }
  .ep-row{ display:flex; gap:16px; align-items:flex-end; margin-bottom:16px; flex-wrap:wrap; }
  .ep-field label{ display:block; font-size:12px; color:var(--text-faint); font-weight:600; margin-bottom:5px; }
  .ep-field input, .ep-field textarea{ font-family:inherit; font-size:13.5px; padding:9px 11px; border:1px solid var(--border); border-radius:6px; width:100%; }
  .ep-table{ width:100%; border-collapse:collapse; margin-bottom:16px; }
  .ep-table th{ text-align:left; font-size:11px; color:var(--text-faint); font-weight:700; padding:7px; border-bottom:1px solid var(--border); }
  .ep-table td{ padding:6px 7px; }
  .ep-table input{ font-family:inherit; font-size:13px; padding:7px 8px; border:1px solid var(--border); border-radius:6px; width:100%; }
  .ep-actions{ display:flex; align-items:center; gap:18px; }
  #saveMsg{ font-size:13px; color:var(--green); font-weight:700; opacity:0; transition:opacity .3s; }
  #saveMsg.show{ opacity:1; }
  .shared-warn{ background:var(--gold-soft); border:1px solid #EAD48A; color:#8A6300; font-size:12.5px; padding:10px 14px; border-radius:7px; margin-bottom:16px; }

  /* ===== PROYECTOS: tarjetas hero ===== */
  .proj-grid{ display:grid; grid-template-columns: repeat(3, 1fr); gap:16px; }
  .proj-card{
    background:#fff; border-radius:14px; padding:22px 20px; box-shadow:0 8px 24px rgba(0,0,0,.22);
    border-top:5px solid var(--grey);
    display:flex; flex-direction:column; gap:14px;
  }
  .proj-card.st-green{ border-top-color:var(--green); }
  .proj-card.st-blue{ border-top-color:var(--blue); }
  .proj-card.st-orange{ border-top-color:var(--orange); }
  .proj-card.st-grey{ border-top-color:var(--grey); }
  .proj-head{ display:flex; align-items:center; gap:12px; }
  .proj-emoji{ font-size:26px; }
  .proj-name{ font-size:15.5px; font-weight:800; color:var(--navy-dark); line-height:1.25; }
  .proj-badge{ font-size:10.5px; font-weight:700; padding:4px 9px; border-radius:20px; display:inline-block; margin-top:4px; }
  .proj-badge.st-green{ background:var(--green-soft); color:#127A50; }
  .proj-badge.st-blue{ background:var(--blue-soft); color:#1D5F9C; }
  .proj-badge.st-orange{ background:var(--orange-soft); color:#B8420A; }
  .proj-badge.st-grey{ background:var(--track); color:var(--text-dim); }

  .proj-mid{ display:flex; align-items:flex-start; gap:16px; }
  .proj-fisico-col{ display:flex; flex-direction:column; align-items:center; flex-shrink:0; }
  .proj-col-lab{ font-size:10.3px; color:var(--text-faint); font-weight:800; letter-spacing:.02em; margin-bottom:8px; text-align:center; }
  .ring-wrap{ position:relative; width:84px; height:84px; }
  .ring-wrap svg{ transform:rotate(-90deg); }
  .ring-track{ fill:none; stroke:var(--track); stroke-width:9; }
  .ring-fg{ fill:none; stroke-width:9; stroke-linecap:round; transition:stroke-dashoffset 1.1s cubic-bezier(.2,.7,.2,1); }
  .ring-val{ position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size:17px; font-weight:800; color:var(--navy-dark); }

  .proj-fin{ flex:1; min-width:0; }
  .proj-fin-lab{ font-size:11px; color:var(--text-faint); font-weight:700; margin-bottom:6px; }
  .proj-fin-track{ height:10px; background:var(--track); border-radius:6px; overflow:hidden; margin-bottom:6px; }
  .proj-fin-fill{ height:100%; width:0; border-radius:6px; transition:width 1.1s; }
  .proj-fin-txt{ font-size:11.8px; color:var(--text-dim); line-height:1.4; }
  .proj-fin-txt b{ color:var(--text); }
  .fin-rows{ margin-top:2px; }
  .fin-row{ display:flex; justify-content:space-between; align-items:baseline; padding:3px 0; font-size:12.3px; border-bottom:1px dotted var(--border); }
  .fin-row:last-child{ border-bottom:none; }
  .fin-row .k{ color:var(--text-faint); font-weight:600; }
  .fin-row .v{ color:var(--navy-dark); font-weight:800; }
  .fin-row.pago .v{ color:var(--green); }
  .fin-row.saldo .v{ color:#B8420A; }
  .fin-scope{ font-size:9.8px; color:var(--text-faint); font-weight:700; letter-spacing:.03em; margin-bottom:6px; }

  .proj-note{ font-size:10.8px; color:var(--text-faint); font-style:italic; border-top:1px dashed var(--border); padding-top:10px; line-height:1.4; }

  /* ===== resumen general ===== */
  .donut-wrap{ display:flex; align-items:center; gap:40px; flex-wrap:wrap; }
  .donut{ width:180px; height:180px; border-radius:50%; position:relative; flex-shrink:0; }
  .donut-center{ position:absolute; inset:30px; background:#fff; border-radius:50%; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; box-shadow: inset 0 0 0 1px var(--border); }
  .donut-center .p{ font-size:28px; font-weight:800; color:var(--navy-dark); line-height:1; }
  .donut-center .l{ font-size:10px; color:var(--text-faint); margin-top:3px; }
  .donut-legend{ flex:1; min-width:280px; }
  .dl-item{ display:flex; align-items:flex-start; gap:12px; margin-bottom:14px; }
  .dl-item:last-child{ margin-bottom:0; }
  .dl-sw{ width:15px; height:15px; border-radius:4px; margin-top:3px; flex-shrink:0; }
  .dl-label{ font-size:13.5px; font-weight:700; color:var(--navy-dark); }
  .dl-amt{ font-size:14px; color:var(--text); margin-top:2px; }
  .dl-amt b{ font-weight:800; }
  .dl-pct{ color:var(--text-faint); font-size:12.5px; }

  .att-grid{ display:grid; grid-template-columns: 1fr 1fr; gap:14px; }
  .att-card{ display:flex; gap:12px; padding:16px; border-radius:10px; background:var(--track); }
  .att-card.warn{ background:var(--gold-soft); }
  .att-card.risk{ background:var(--orange-soft); }
  .att-icon{ width:32px; height:32px; border-radius:50%; flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:16px; font-weight:800; color:#fff; }
  .att-body b{ display:block; font-size:13.5px; color:var(--navy-dark); margin-bottom:3px; }
  .att-body span{ font-size:12.8px; color:var(--text-dim); line-height:1.5; }

  footer{ margin-top:6px; font-size:11px; color:#7E93AD; line-height:1.7; padding: 4px 4px 0; }
  footer b{ color:#BFD2E8; }

  @media (max-width: 1100px){ .proj-grid{ grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 700px){ .proj-grid{ grid-template-columns: 1fr; } .att-grid{ grid-template-columns:1fr; } .wrap{ padding:24px 18px 0; } .head{ padding:22px 18px 26px; } }
</style>
</head>
<body>

  <div class="head">
    <div>
      <h1>Herramienta de Seguimiento — Proyecto de Inversión PIIP ESAP Nacional</h1>
      <div class="sub">Consolidación de la capacidad física instalada · Corte al <span id="corteTxt">31 de agosto de 2026</span></div>
    </div>
    <div class="head-right">
      <div style="text-align:right;">
        <button class="btn btn-ghost" id="toggleEdit">✎ Actualizar datos</button>
        <div class="sync-note" id="lastUpd">● sin ediciones registradas todavía</div>
      </div>
      <div class="head-amt"><div class="lab">PRESUPUESTO TOTAL 2026</div><b id="apropTxt">$59.000.000.000</b></div>
    </div>
  </div>

  <div class="wrap">

  <!-- ================= EDIT PANEL ================= -->
  <div class="card" id="editPanel">
    <div class="section-title dark" style="margin-bottom:4px;">Actualizar cifras del corte</div>
    <div class="section-sub">Los cambios quedan visibles para todo el equipo.</div>
    <div class="shared-warn">💾 Esto se guarda en el navegador donde lo edites. Es el paso para que tú (o quien reciba los datos de Francisco y Camilo) actualice la herramienta y luego publique de nuevo el archivo en GitHub Pages — así todos ven la misma versión al abrir el link.</div>

    <div class="ep-row">
      <div class="ep-field" style="max-width:220px;"><label>Fecha de corte</label><input type="text" id="inCorte"></div>
      <div class="ep-field" style="max-width:200px;"><label>Presupuesto total (millones)</label><input type="number" id="inApropTotal" step="0.01"></div>
      <div class="ep-field" style="max-width:220px;"><label>Actualizado por</label><input type="text" id="inAutor" placeholder="Tu nombre"></div>
    </div>

    <div class="section-title dark" style="font-size:15px;">Cifras financieras por actividad (millones)</div>
    <table class="ep-table">
      <tr><th>Actividad del PIIP</th><th>Presupuesto</th><th>Comprometido</th><th>Obligado</th><th>Pagado</th></tr>
      <tbody id="actBody"></tbody>
    </table>

    <div class="section-title dark" style="font-size:15px;">Avance físico por proyecto (%)</div>
    <table class="ep-table">
      <tr><th>Proyecto</th><th>Avance físico (%)</th><th>Estado</th></tr>
      <tbody id="obraBody"></tbody>
    </table>

    <div class="section-title dark" style="font-size:15px;">Notas adicionales</div>
    <textarea id="inNotes" rows="3" style="margin-bottom:16px;" placeholder="Ej: Se firmó el contrato XYZ-2026 con la empresa ABC para Popayán, por $450.000.000."></textarea>

    <div class="ep-actions">
      <button class="btn btn-primary" id="saveBtn">Guardar cambios</button>
      <button class="btn btn-link" id="resetBtn">Restablecer a datos base (agosto 2026)</button>
      <span id="saveMsg">Guardado ✓</span>
    </div>
  </div>

  <!-- ================= PROYECTOS (HERO) ================= -->
  <div class="sect">
    <div class="section-title">Proyectos del PIIP: avance físico y financiero</div>
    <div class="section-sub light">Cada tarjeta muestra qué tan construida va la obra y cuánto se ha pagado de su contrato</div>
    <div class="proj-grid" id="projGrid"></div>
  </div>

  <!-- ================= RESUMEN GENERAL ================= -->
  <div class="card sect" style="background:linear-gradient(135deg,#0F2E52,#123A63); box-shadow:0 10px 32px rgba(10,34,64,.35);">
    <div class="section-title" style="color:#fff;">Resumen general del proyecto de inversión</div>
    <div class="section-sub light">Del presupuesto total asignado al PIIP para 2026 — visto de un solo vistazo</div>
    <div class="donut-wrap">
      <div class="donut" id="donutEl" style="box-shadow:0 0 0 8px rgba(255,255,255,.06), 0 12px 30px rgba(0,0,0,.35);">
        <div class="donut-center"><div class="p" id="donutCenterPct">—</div><div class="l">ya se ha pagado</div></div>
      </div>
      <div class="donut-legend">
        <div class="dl-item"><span class="dl-sw" style="background:var(--green)"></span><div><div class="dl-label" style="color:#fff;">Ya pagado</div><div class="dl-amt" id="dlPagado" style="color:#DCE9F8;">—</div></div></div>
        <div class="dl-item"><span class="dl-sw" style="background:var(--gold)"></span><div><div class="dl-label" style="color:#fff;">Comprometido, pendiente de pago</div><div class="dl-amt" id="dlComp" style="color:#DCE9F8;">—</div></div></div>
        <div class="dl-item"><span class="dl-sw" style="background:var(--grey)"></span><div><div class="dl-label" style="color:#fff;">Todavía sin comprometer</div><div class="dl-amt" id="dlDisp" style="color:#DCE9F8;">—</div></div></div>
      </div>
    </div>
    <div style="margin-top:18px; padding-top:16px; border-top:1px solid rgba(255,255,255,.15); font-size:13px; color:#BFD2E8; line-height:1.6;" id="donutCaption">—</div>
  </div>

  <!-- ================= PUNTOS DE ATENCION ================= -->
  <div class="card">
    <div class="section-title dark">Puntos que requieren atención</div>
    <div class="section-sub">Lo más importante de este corte, en pocas palabras</div>
    <div class="att-grid" id="alertList"></div>
  </div>

  <footer>
    <b>Elaborado por</b> Duberly Karime Carvajal Pico · Con Francisco Alexander Cobaleda Tinoco y Jhon Camilo Medina Garzón (Grupo de Infraestructura y Mantenimiento, ESAP).<br>
    Información construida a partir de fuentes oficiales verificables: Informe de Seguimiento Mensual PIIP (DE-FO-011), Relación de Sedes Adquiridas Nivel Nacional 2026, correo del CDP 156525, y Reporte SIIF Nación de Relación de Pagos (Compromiso 301926).
  </footer>

  </div>

<script>
  const RING_C = 2*Math.PI*38; // circunferencia r=38

  const BASE_DATA = {
    corte: "31 de agosto de 2026",
    apropiacion: 59000,
    lastUpdated: { by: "línea base", at: "" },
    customNotes: [],
    actividades: [
      { nombre: "Sedes construidas y dotadas", apropiacion: 27685.80, compromiso: 4705.61, obligacion: 2565.06, pago: 2565.06 },
      { nombre: "Sedes mantenidas",            apropiacion: 16660.999, compromiso: 3805.75, obligacion: 1975.09, pago: 1964.96 },
      { nombre: "Sedes adecuadas",             apropiacion: 11000.00, compromiso: 3009.21, obligacion: 643.43,  pago: 643.43 },
      { nombre: "Sedes adquiridas",            apropiacion: 2598.78,  compromiso: 2117.49, obligacion: 1203.72, pago: 1198.64 },
      { nombre: "Sedes dotadas",               apropiacion: 1054.42,  compromiso: 722.73,  obligacion: 413.24,  pago: 413.24 }
    ],
    // proyectos reales: cada uno pertenece a una actividad del PIIP.
    // los que tienen contratoValor/contratoPagado usan su propio dato financiero real (contrato específico);
    // los que no, muestran el agregado de su actividad, dejándolo claro en la nota.
    obras: [
      { nombre: "Biblioteca Sede Central CAN", emoji:"📚", avance: 90, estado: "Fase final de acabados",
        actividadPadre: "Sedes adecuadas", contratoValor: 831.804578, contratoPagado: 643.431507,
        contratoNota: "Contrato BOG-1256-2026 con Monval Group S.A.S. (Compromiso 301926)" },
      { nombre: "Pasillos y zonas comunes CAN", emoji:"🚪", avance: 20, estado: "En construcción",
        actividadPadre: "Sedes adecuadas" },
      { nombre: "Sistema hidrosanitario CAN", emoji:"🚰", avance: 10.8, estado: "En construcción",
        actividadPadre: "Sedes adecuadas" },
      { nombre: "Escenarios deportivos CAN", emoji:"⚽", monto: 660.988736, estado: "Compromiso reciente, sin % físico aún",
        actividadPadre: "Sedes mantenidas" },
      { nombre: "Áreas comunes CAN", emoji:"🌳", monto: 756.589851, estado: "Compromiso reciente, sin % físico aún",
        actividadPadre: "Sedes mantenidas" },
      { nombre: "Nueva sede Villavicencio", emoji:"🏗️", avance: 77.89, estado: "Obra detenida temporalmente",
        actividadPadre: "Sedes construidas y dotadas" },
      { nombre: "Sede Neiva · Etapa II", emoji:"🏗️", avance: 5.27, estado: "En construcción, ritmo lento",
        actividadPadre: "Sedes construidas y dotadas" }
    ]
  };

  let DATA = null;

  function fmtM(n){ return '$' + Math.round(Number(n)*1000000).toLocaleString('es-CO'); }
  function pct(n){ return Number(n).toLocaleString('es-CO', {minimumFractionDigits:1, maximumFractionDigits:1}) + '%'; }
  function pct0(n){ return Number(n).toLocaleString('es-CO', {maximumFractionDigits:0}) + '%'; }

  function statusClass(estado){
    if(estado.includes('detenida')) return 'orange';
    if(estado.includes('final')) return 'green';
    if(estado.includes('reciente')) return 'grey';
    return 'blue';
  }
  function statusColorVar(cls){
    return cls==='green' ? 'var(--green)' : cls==='orange' ? 'var(--orange)' : cls==='grey' ? 'var(--grey)' : 'var(--blue)';
  }

  function render(data){
    const apr = data.apropiacion;
    const totComp = data.actividades.reduce((s,a)=>s+Number(a.compromiso),0);
    const totObl  = data.actividades.reduce((s,a)=>s+Number(a.obligacion),0);
    const totPag  = data.actividades.reduce((s,a)=>s+Number(a.pago),0);

    document.getElementById('corteTxt').textContent = data.corte;
    document.getElementById('apropTxt').textContent = fmtM(apr);
    if(data.lastUpdated && data.lastUpdated.at){
      document.getElementById('lastUpd').textContent = '● act. '+data.lastUpdated.at+' por '+data.lastUpdated.by;
    }

    const pagado = Math.max(totPag,0), compPend = Math.max(totComp-totPag,0), disp = Math.max(apr-totComp,0);
    const wPag = apr>0?pagado/apr*100:0, wComp = apr>0?compPend/apr*100:0, wDisp = apr>0?disp/apr*100:0;

    document.getElementById('donutEl').style.background =
      'conic-gradient(var(--green) 0% '+wPag+'%, var(--gold) '+wPag+'% '+(wPag+wComp)+'%, var(--grey) '+(wPag+wComp)+'% 100%)';
    document.getElementById('donutCenterPct').textContent = pct0(wPag);
    document.getElementById('dlPagado').innerHTML = '<b>'+fmtM(pagado)+'</b> <span class="dl-pct">('+pct(wPag)+')</span>';
    document.getElementById('dlComp').innerHTML = '<b>'+fmtM(compPend)+'</b> <span class="dl-pct">('+pct(wComp)+')</span>';
    document.getElementById('dlDisp').innerHTML = '<b>'+fmtM(disp)+'</b> <span class="dl-pct">('+pct(wDisp)+')</span>';
    document.getElementById('donutCaption').innerHTML =
      'De los <b style="color:#fff;">$59.000.000.000</b> del proyecto, ya se comprometieron <b style="color:#fff;">'+fmtM(totComp)+'</b> ('+pct(totComp/apr*100)+'). De eso, ya se pagó lo que se ve en verde, y lo dorado es lo que ya está prometido pero todavía no se ha desembolsado.';

    // proyectos
    const pg = document.getElementById('projGrid'); pg.innerHTML='';
    data.obras.forEach(o=>{
      const cls = statusClass(o.estado);
      const color = statusColorVar(cls);
      const card = document.createElement('div');
      card.className = 'proj-card st-'+cls;

      let ringHtml, finHtml, noteHtml;

      if(o.avance !== undefined){
        const off = RING_C - RING_C*Math.min(o.avance,100)/100;
        ringHtml = '<svg width="84" height="84" viewBox="0 0 84 84">'+
          '<circle class="ring-track" cx="42" cy="42" r="38"/>'+
          '<circle class="ring-fg" cx="42" cy="42" r="38" stroke="'+color+'" stroke-dasharray="'+RING_C.toFixed(1)+'" stroke-dashoffset="'+off.toFixed(1)+'"/>'+
          '</svg><div class="ring-val">'+pct0(o.avance)+'</div>';
      } else {
        ringHtml = '<svg width="84" height="84" viewBox="0 0 84 84">'+
          '<circle class="ring-track" cx="42" cy="42" r="38"/></svg>'+
          '<div class="ring-val" style="font-size:11px; line-height:1.2;">Aún sin<br>dato</div>';
      }

      if(o.contratoValor !== undefined){
        const pFin = o.contratoPagado/o.contratoValor*100;
        const saldo = o.contratoValor - o.contratoPagado;
        finHtml =
          '<div class="fin-scope">DATOS DEL CONTRATO</div>'+
          '<div class="proj-fin-track"><div class="proj-fin-fill" style="width:'+pFin+'%; background:'+color+'"></div></div>'+
          '<div class="fin-rows">'+
            '<div class="fin-row"><span class="k">Valor del contrato</span><span class="v">'+fmtM(o.contratoValor)+'</span></div>'+
            '<div class="fin-row pago"><span class="k">Pagado ('+pct0(pFin)+')</span><span class="v">'+fmtM(o.contratoPagado)+'</span></div>'+
            '<div class="fin-row saldo"><span class="k">Saldo por pagar</span><span class="v">'+fmtM(saldo)+'</span></div>'+
          '</div>';
        noteHtml = o.contratoNota || '';
      } else {
        const act = data.actividades.find(a=>a.nombre===o.actividadPadre);
        const montoRow = o.monto!==undefined
          ? '<div class="fin-row"><span class="k">Comprometido en este proyecto</span><span class="v">'+fmtM(o.monto)+'</span></div>'
          : '';
        finHtml =
          '<div class="fin-scope">SIN CONTRATO ESPECÍFICO DESGLOSADO</div>'+
          (montoRow ? '<div class="fin-rows">'+montoRow+'</div>' : '')+
          '<div class="proj-fin-txt" style="margin-top:8px;">El informe PIIP no reporta el valor, lo pagado ni el saldo de este proyecto por separado. Esta obra comparte la actividad presupuestal <b>"'+(act?act.nombre:o.actividadPadre)+'"</b> con otros proyectos, así que no hay una cifra que le pertenezca únicamente a ella.</div>';
        noteHtml = '📋 Solo se muestra el avance físico de este proyecto; el avance financiero por obra individual no está disponible en los reportes actuales.';
      }

      card.innerHTML =
        '<div class="proj-head"><span class="proj-emoji">'+o.emoji+'</span><div><div class="proj-name">'+o.nombre+'</div><span class="proj-badge st-'+cls+'">'+o.estado+'</span></div></div>'+
        '<div class="proj-mid">'+
          '<div class="proj-fisico-col"><div class="proj-col-lab">AVANCE<br>FÍSICO</div><div class="ring-wrap">'+ringHtml+'</div></div>'+
          '<div class="proj-fin"><div class="proj-col-lab" style="text-align:left;">AVANCE FINANCIERO</div>'+finHtml+'</div>'+
        '</div>'+
        '<div class="proj-note">'+noteHtml+'</div>';
      pg.appendChild(card);
    });

    renderAttention(data);
  }

  function addAtt(container, cls, icon, title, detail){
    const div=document.createElement('div'); div.className='att-card '+cls;
    const color = cls==='risk' ? 'var(--orange)' : (cls==='warn' ? '#B98A0E' : 'var(--navy)');
    div.innerHTML='<span class="att-icon" style="background:'+color+'">'+icon+'</span><div class="att-body"><b>'+title+'</b><span>'+detail+'</span></div>';
    container.appendChild(div);
  }

  function renderAttention(data){
    const box = document.getElementById('alertList'); box.innerHTML='';

    data.obras.forEach(o=>{
      if(o.estado && o.estado.includes('detenida')){
        addAtt(box, 'warn', '!', o.nombre+' está detenida', 'Lleva un '+pct(o.avance)+' de avance construido, pero la obra está parada por una revisión de seguridad estructural.');
      }
    });
    data.actividades.forEach(a=>{
      if(a.compromiso>0 && (a.obligacion/a.compromiso) < 0.3){
        addAtt(box, 'risk', '!', a.nombre+': ritmo lento', 'Ya se comprometió dinero, pero todavía se debe muy poco de eso ('+pct(a.obligacion/a.compromiso*100)+') — la ejecución real va lenta.');
      }
    });
    addAtt(box, 'plain', 'i', 'CDP 156525 — reserva sin ejecutar', 'Valor de la reserva: <b>$6.499.545.238</b> · Pagado: <b>$0</b> · Saldo: <b>$6.499.545.238</b>. Corresponde al contrato BOG-1363-2025 de mantenimiento nacional con Consorcio Sedes Tupeón — aún no se ha empezado a ejecutar.');
    addAtt(box, 'plain', 'i', 'Arriendos: Chocó es la territorial más atrasada', 'A nivel nacional ya se pagó cerca del 57% de lo comprometido en sedes adquiridas; en Chocó solo se ha pagado el 27%.');
    (data.customNotes||[]).forEach(note=>{ addAtt(box, 'plain', '✎', 'Nota del equipo', note); });
    if(box.children.length === 0){ addAtt(box, 'plain', '✓', 'Todo en orden', 'No hay puntos de atención con los datos actuales.'); }
  }

  function buildEditForm(data){
    const actBody=document.getElementById('actBody'); actBody.innerHTML='';
    data.actividades.forEach((a,i)=>{
      const tr=document.createElement('tr');
      tr.innerHTML='<td>'+a.nombre+'</td>'+
        '<td><input type="number" step="0.01" data-idx="'+i+'" data-field="apropiacion" value="'+a.apropiacion+'"></td>'+
        '<td><input type="number" step="0.01" data-idx="'+i+'" data-field="compromiso" value="'+a.compromiso+'"></td>'+
        '<td><input type="number" step="0.01" data-idx="'+i+'" data-field="obligacion" value="'+a.obligacion+'"></td>'+
        '<td><input type="number" step="0.01" data-idx="'+i+'" data-field="pago" value="'+a.pago+'"></td>';
      actBody.appendChild(tr);
    });
    const obraBody=document.getElementById('obraBody'); obraBody.innerHTML='';
    data.obras.forEach((o,i)=>{
      if(o.avance === undefined) return;
      const tr=document.createElement('tr');
      tr.innerHTML='<td>'+o.nombre+'</td>'+
        '<td><input type="number" step="0.01" data-oidx="'+i+'" data-ofield="avance" value="'+o.avance+'"></td>'+
        '<td><input type="text" data-oidx="'+i+'" data-ofield="estado" value="'+o.estado+'"></td>';
      obraBody.appendChild(tr);
    });
    document.getElementById('inCorte').value = data.corte;
    document.getElementById('inApropTotal').value = data.apropiacion;
    document.getElementById('inNotes').value = (data.customNotes||[]).join('\n');
    document.getElementById('inAutor').value = '';
  }

  function readFormIntoData(){
    DATA.corte = document.getElementById('inCorte').value || DATA.corte;
    DATA.apropiacion = parseFloat(document.getElementById('inApropTotal').value) || DATA.apropiacion;
    DATA.customNotes = document.getElementById('inNotes').value.split('\n').map(s=>s.trim()).filter(Boolean);
    const autor = document.getElementById('inAutor').value.trim() || 'alguien del equipo';
    document.querySelectorAll('#actBody input').forEach(inp=>{
      DATA.actividades[+inp.dataset.idx][inp.dataset.field] = parseFloat(inp.value)||0;
    });
    document.querySelectorAll('#obraBody input').forEach(inp=>{
      const field = inp.dataset.ofield;
      DATA.obras[+inp.dataset.oidx][field] = field==='estado' ? inp.value : (parseFloat(inp.value)||0);
    });
    DATA.lastUpdated = { by: autor, at: new Date().toLocaleString('es-CO', {day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) };
  }

  async function loadData(){
    try{
      const raw = localStorage.getItem('piip_data_v1');
      if(raw){ DATA = JSON.parse(raw); return; }
    }catch(e){}
    DATA = JSON.parse(JSON.stringify(BASE_DATA));
  }
  async function saveData(){
    try{
      localStorage.setItem('piip_data_v1', JSON.stringify(DATA));
      const msg=document.getElementById('saveMsg');
      msg.classList.add('show');
      setTimeout(()=>msg.classList.remove('show'),2200);
    }catch(e){ alert('No se pudo guardar. Intenta de nuevo.'); }
  }

  document.getElementById('toggleEdit').addEventListener('click', async ()=>{
    const panel = document.getElementById('editPanel');
    const willOpen = !panel.classList.contains('open');
    if(willOpen){ await loadData(); render(DATA); buildEditForm(DATA); }
    panel.classList.toggle('open');
  });
  document.getElementById('saveBtn').addEventListener('click', async ()=>{
    readFormIntoData(); await saveData(); render(DATA);
  });
  document.getElementById('resetBtn').addEventListener('click', async ()=>{
    if(!confirm('¿Restablecer para TODO el equipo a los datos base de agosto 2026?')) return;
    DATA = JSON.parse(JSON.stringify(BASE_DATA));
    buildEditForm(DATA); await saveData(); render(DATA);
  });

  (async function init(){
    await loadData();
    buildEditForm(DATA);
    render(DATA);
  })();
</script>

</body>
</html>
